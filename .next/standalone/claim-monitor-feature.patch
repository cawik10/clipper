+
+async function recordError(id: number, message: string): Promise<VideoClaimWatchRow> {
+  const [row] = await db
+    .update(videoClaimWatch)
+    .set({ lastError: message.slice(0, 300), updatedAt: new Date() })
+    .where(eq(videoClaimWatch.id, id))
+    .returning();
+  return row;
+}
+
+function friendlyError(message: string, kind: string): string {
+  if (kind === "permission") {
+    return `Izin YouTube belum cukup untuk mengubah video. Kirim /connect sekali lagi lalu coba tombolnya lagi. (${message.slice(0, 120)})`;
+  }
+  if (kind === "quota") return "Kuota YouTube API hari ini habis. Coba lagi besok.";
+  return message.slice(0, 200);
+}
+
+function hasClaimScope(scope: string | null | undefined): boolean | null {
+  if (!scope || !scope.trim()) return null; // tidak diketahui → coba saja
+  const granted = scope.split(/[\s,]+/);
+  return CLAIM_REQUIRED_SCOPES.some((s) => granted.includes(s));
+}
+
+/**
+ * Jalankan keputusan user atas satu alert.
+ *  - ignore  → tandai diabaikan (tidak dialert lagi sampai klaim lepas lalu muncul lagi)
+ *  - private → ubah privasi video (CLAIM_MONITOR_HIDE_TO, default private)
+ *  - delete  → hapus video dari YouTube (videos.delete)
+ * Kalau gagal (mis. izin kurang), alert tetap "pending" supaya bisa dicoba lagi.
+ */
+export async function applyClaimDecision(userId: string, id: number, decision: ClaimDecision): Promise<ClaimDecisionResult> {
+  const row = await getOwnedClaim(userId, id);
+  if (!row) return { ok: false, message: "Alert tidak ditemukan." };
+  if (row.actionStatus !== "pending") {
+    return { ok: false, status: row.actionStatus, row, message: `Alert ini sudah diputuskan (${row.actionStatus}).` };
+  }
+
+  if (decision === "ignore") {
+    const updated = await setAction(id, "ignored");
+    return { ok: true, status: "ignored", row: updated, message: CLAIM_TEXT.ignored };
+  }
+
+  if (!getClaimActions().includes(decision)) {
+    return { ok: false, row, message: `Aksi "${decision}" dimatikan lewat CLAIM_MONITOR_ACTIONS.` };
+  }
+
+  let client: Awaited<ReturnType<typeof getYoutubeClient>>;
+  try {
+    client = await getYoutubeClient(userId);
+  } catch (err) {
+    const msg = err instanceof Error ? err.message : String(err);
+    return { ok: false, row: await recordError(id, msg), message: friendlyError(msg, "youtube") };
+  }
+  if (!("youtube" in client)) {
+    const updated = await recordError(id, client.error);
+    return { ok: false, row: updated, message: friendlyError(client.error, client.kind) };
+  }
+  if (hasClaimScope(client.scope) === false) {
+    const msg = "Izin YouTube belum cukup untuk mengubah video (butuh youtube.force-ssl). Kirim /connect sekali lagi.";
+    const updated = await recordError(id, msg);
+    return { ok: false, row: updated, message: msg };
+  }
+  const { youtube } = client;
+
+  try {
+    if (decision === "delete") {
+      try {
+        await youtube.videos.delete({ id: row.youtubeVideoId });
+      } catch (err) {
+        const status = Number((err as { code?: number | string })?.code ?? (err as { response?: { status?: number } })?.response?.status);
+        if (status !== 404) throw err; // 404 = sudah tidak ada → anggap berhasil
+      }
+      const updated = await setAction(id, "deleted");
+      return { ok: true, status: "deleted", row: updated, message: CLAIM_TEXT.deleted };
+    }
+
+    // private/unlisted: videos.update part=status — field status lain dipertahankan supaya tidak ter-reset
+    const current = await youtube.videos.list({ part: ["status"], id: [row.youtubeVideoId] });
+    const status = current.data.items?.[0]?.status;
+    if (!status) {
+      const updated = await setAction(id, "deleted", "Video tidak ditemukan di YouTube (mungkin sudah dihapus)");
+      return { ok: true, status: "deleted", row: updated, message: "ℹ️ Video sudah tidak ada di YouTube." };
+    }
+    const hideTo = getClaimHideTo();
+    if (status.privacyStatus !== hideTo) {
+      const { uploadStatus, failureReason, rejectionReason, madeForKids, publishAt, ...editable } = status;
+      await youtube.videos.update({
+        part: ["status"],
+        requestBody: { id: row.youtubeVideoId, status: { ...editable, privacyStatus: hideTo } },
+      });
+    }
+    const updated = await setAction(id, hideTo);
+    await db.update(videoClaimWatch).set({ privacyStatus: hideTo }).where(eq(videoClaimWatch.id, id));
+    return { ok: true, status: hideTo, row: { ...updated, privacyStatus: hideTo }, message: hideTo === "private" ? CLAIM_TEXT.privated : CLAIM_TEXT.unlisted };
+  } catch (err) {
+    const c = classifyError(err);
+    const updated = await recordError(id, c.message);
+    return { ok: false, row: updated, message: friendlyError(c.message, c.kind) };
+  }
+}
+
+// ─── INTI: DISCOVER → CHECK → ALERT → BLACKLIST ──────────────────────────
+
+const globalForClaims = globalThis as typeof globalThis & { __claimMonitorRunning?: boolean };
+
+export interface RunClaimOptions {
+  /** Batasi ke satu user. */
+  userId?: string;
+  /** Abaikan jeda pengecekan (cek semua video sekarang). */
+  force?: boolean;
+  /** false = jangan kirim alert Telegram (default: ikut CLAIM_MONITOR_NOTIFY). */
+  notify?: boolean;
+  /** true = kirim ulang semua alert yang masih menunggu. */
+  resend?: boolean;
+}
+
+export async function runClaimMonitor(opts: RunClaimOptions = {}): Promise<ClaimRunSummary> {
+  const summary: ClaimRunSummary = {
+    enabled: isClaimMonitorEnabled(),
+    discovered: 0,
+    users: 0,
+    checked: 0,
+    newClaims: 0,
+    cleared: 0,
+    missing: 0,
+    alerted: 0,
+    blacklisted: 0,
+    errors: [],
+  };
+  if (!summary.enabled) return summary;
+  if (globalForClaims.__claimMonitorRunning) {
+    summary.errors.push("Siklus sebelumnya masih berjalan");
+    return summary;
+  }
+  globalForClaims.__claimMonitorRunning = true;
+
+  try {
+    await ensureClaimTables();
+    summary.discovered = await discoverClaimWatch(opts.userId);
+
+    const cutoff = new Date(Date.now() - getClaimTrackDays() * DAY);
+    const conditions = [gte(videoClaimWatch.uploadedAt, cutoff), ne(videoClaimWatch.claimState, "missing")];
+    if (opts.userId) conditions.push(eq(videoClaimWatch.telegramUserId, opts.userId));
+    const rows = await db.select().from(videoClaimWatch).where(and(...conditions));
+
+    const now = Date.now();
+    const byUser = new Map<string, VideoClaimWatchRow[]>();
+    for (const r of rows) {
+      if (!isDue(r, now, !!opts.force)) continue;
+      const list = byUser.get(r.telegramUserId) || [];
+      list.push(r);
+      byUser.set(r.telegramUserId, list);
+    }
+    // user yang punya alert menunggu juga diproses (untuk pengingat), walau tak ada video due
+    if (opts.resend || getClaimReminderHours() > 0) {
+      for (const r of await getPendingClaims(opts.userId ?? null, 500)) if (!byUser.has(r.telegramUserId)) byUser.set(r.telegramUserId, []);
+    }
+    summary.users = byUser.size;
+
+    for (const [userId, due] of byUser) {
+      try {
+        if (due.length) {
+          const r = await checkUserVideos(userId, due);
+          summary.checked += r.checked;
+          summary.newClaims += r.newClaims;
+          summary.cleared += r.cleared;
+          summary.missing += r.missing;
+          for (const e of r.errors) summary.errors.push(`user ${userId}: ${e}`);
+        }
+
+        // Rasio klaim → auto-blacklist
+        const added = await evaluateAutoBlacklist(userId);
+        summary.blacklisted += added.length;
+
+        // Alert klaim (baru, atau pengingat)
+        const notify = opts.notify ?? isClaimNotifyEnabled();
+        if (notify) {
+          const pending = await getPendingClaims(userId, 500);
+          const reminderMs = getClaimReminderHours() * HOUR;
+          const dueAlerts = pending.filter((p) => {
+            if (opts.resend) return true;
+            if (!p.lastNotifiedAt) return true;
+            return reminderMs > 0 && Date.now() - p.lastNotifiedAt.getTime() >= reminderMs;
+          });
+          const batch = dueAlerts.slice(0, getClaimMaxAlertsPerCycle());
+          if (batch.length) {
+            try {
+              summary.alerted += await sendClaimAlerts(userId, batch, dueAlerts.length);
+            } catch (err) {
+              summary.errors.push(`Telegram: ${err instanceof Error ? err.message : String(err)}`);
+            }
+          }
+        }
+        if (added.length && isBlacklistNotifyEnabled() && (opts.notify ?? isClaimNotifyEnabled())) {
+          await sendBlacklistNotice(userId, added);
+        }
+      } catch (err) {
+        summary.errors.push(`user ${userId}: ${err instanceof Error ? err.message : String(err)}`);
+      }
+    }
+  } catch (err) {
+    summary.errors.push(err instanceof Error ? err.message : String(err));
+  } finally {
+    globalForClaims.__claimMonitorRunning = false;
+  }
+  return summary;
+}
diff --git a/src/lib/source-blacklist.ts b/src/lib/source-blacklist.ts
new file mode 100644
index 0000000..6240b12
--- /dev/null
+++ b/src/lib/source-blacklist.ts
@@ -0,0 +1,254 @@
+/**
+ * ⛔ SOURCE CHANNEL BLACKLIST (FITUR BARU! bagian dari Post-Upload Claim Monitor)
+ * =====================================================================
+ * Penyimpanan + pencocokan blacklist source channel. Dipakai oleh:
+ *   - Claim Monitor (src/lib/claim-monitor.ts)  → auto-blacklist dari rasio klaim
+ *   - Source Guard  (src/lib/source-guard.ts)   → tolak/peringatkan job dari channel blacklist
+ *   - Auto-Monitor  (src/lib/channel-monitor-worker.ts) → lewati monitor channel blacklist
+ *   - Perintah /blacklist (src/lib/claim-monitor-telegram.ts)
+ *
+ * Sumber blacklist:
+ *   1. Tabel `source_blacklist` (per user Telegram) — auto atau manual (/blacklist add)
+ *   2. Env CLAIM_BLACKLIST_CHANNELS (global, semua user)
+ *
+ * Pencocokan memakai "token" channel yang sama seperti whitelist Source Guard
+ * (ID UCxxx / @handle / nama / URL → huruf kecil, tanpa @) — lihat
+ * normalizeChannelToken di source-guard.ts. File ini sengaja TIDAK diimpor
+ * statis oleh source-guard.ts (dipakai lewat dynamic import) agar tidak circular.
+ */
+
+import { and, eq, ne, sql } from "drizzle-orm";
+import { db } from "@/db";
+import { sourceBlacklist, type SourceBlacklistRow } from "@/db/schema";
+import { getEnvBlacklist } from "@/lib/claim-monitor-config";
+import { normalizeChannelToken } from "@/lib/source-guard";
+
+// ─── TABEL (dibuat otomatis) ─────────────────────────────────────────────
+
+let tableReady: Promise<void> | null = null;
+
+export function ensureBlacklistTable(): Promise<void> {
+  if (!tableReady) {
+    tableReady = (async () => {
+      await db.execute(sql`
+        CREATE TABLE IF NOT EXISTS source_blacklist (
+          id serial PRIMARY KEY,
+          telegram_user_id text NOT NULL,
+          channel_key text NOT NULL,
+          channel_name text,
+          tokens text NOT NULL DEFAULT '[]',
+          origin text NOT NULL DEFAULT 'manual',
+          reason text,
+          claims integer NOT NULL DEFAULT 0,
+          clips integer NOT NULL DEFAULT 0,
+          ratio_percent integer NOT NULL DEFAULT 0,
+          created_at timestamp NOT NULL DEFAULT now()
+        )
+      `);
+      await db.execute(sql`
+        CREATE UNIQUE INDEX IF NOT EXISTS source_blacklist_user_key_idx ON source_blacklist (telegram_user_id, channel_key)
+      `);
+    })().catch((err) => {
+      tableReady = null;
+      throw err;
+    });
+  }
+  return tableReady;
+}
+
+// ─── TOKEN ───────────────────────────────────────────────────────────────
+
+/** Gabungkan beberapa identitas channel (id/nama/handle/URL) jadi daftar token unik. */
+export function buildChannelTokens(values: Array<string | null | undefined>): string[] {
+  const out = new Set<string>();
+  for (const v of values) {
+    if (!v) continue;
+    const t = normalizeChannelToken(v);
+    if (t) out.add(t);
+  }
+  return Array.from(out);
+}
+
+export function parseTokens(raw: string | null | undefined): string[] {
+  if (!raw) return [];
+  try {
+    const parsed = JSON.parse(raw);
+    return Array.isArray(parsed) ? parsed.filter((t): t is string => typeof t === "string" && !!t) : [];
+  } catch {
+    return [];
+  }
+}
+
+// ─── CRUD ────────────────────────────────────────────────────────────────
+
+/** Blacklist AKTIF milik user (entri "released" = auto-blacklist yang sudah dilepas user, tidak ikut). */
+export async function listBlacklist(userId: string): Promise<SourceBlacklistRow[]> {
+  await ensureBlacklistTable();
+  return db
+    .select()
+    .from(sourceBlacklist)
+    .where(and(eq(sourceBlacklist.telegramUserId, userId), ne(sourceBlacklist.origin, "released")))
+    .orderBy(sourceBlacklist.id);
+}
+
+/**
+ * Entri auto-blacklist yang sudah DILEPAS user (tombol "Keluarkan" / /blacklist remove).
+ * Disimpan sebagai penanda supaya channel tidak langsung di-blacklist lagi oleh rasio lama —
+ * baru dipertimbangkan lagi kalau ada klaim BARU setelah dilepas.
+ */
+export async function findReleasedEntry(userId: string, tokens: string[]): Promise<SourceBlacklistRow | null> {
+  await ensureBlacklistTable();
+  const rows = await db
+    .select()
+    .from(sourceBlacklist)
+    .where(and(eq(sourceBlacklist.telegramUserId, userId), eq(sourceBlacklist.origin, "released")));
+  return rows.find((r) => parseTokens(r.tokens).some((t) => tokens.includes(t)) || tokens.includes(r.channelKey)) ?? null;
+}
+
+/** Cepat: apakah ada isi blacklist sama sekali (env atau milik user)? Dipakai Source Guard agar hemat. */
+export async function hasAnyBlacklist(userId: string): Promise<boolean> {
+  if (getEnvBlacklist().length > 0) return true;
+  return (await listBlacklist(userId)).length > 0;
+}
+
+export async function getBlacklistEntry(userId: string, id: number): Promise<SourceBlacklistRow | null> {
+  await ensureBlacklistTable();
+  const rows = await db
+    .select()
+    .from(sourceBlacklist)
+    .where(and(eq(sourceBlacklist.id, id), eq(sourceBlacklist.telegramUserId, userId)));
+  return rows[0] ?? null;
+}
+
+export interface AddBlacklistInput {
+  /** Identitas channel (id/nama/handle/URL) — semua dijadikan token pembanding. */
+  identities: Array<string | null | undefined>;
+  /** Nama tampilan. */
+  label?: string | null;
+  origin: "auto" | "manual";
+  reason?: string | null;
+  claims?: number;
+  clips?: number;
+  ratioPercent?: number;
+}
+
+/** Tambah ke blacklist user. Idempotent: kalau channel (token mana pun) sudah ada → added=false. */
+export async function addBlacklistEntry(
+  userId: string,
+  input: AddBlacklistInput
+): Promise<{ added: boolean; row: SourceBlacklistRow | null; tokens: string[] }> {
+  await ensureBlacklistTable();
+  const tokens = buildChannelTokens(input.identities);
+  if (!tokens.length) return { added: false, row: null, tokens };
+
+  const existing = await listBlacklist(userId);
+  const dup = existing.find((r) => parseTokens(r.tokens).some((t) => tokens.includes(t)) || tokens.includes(r.channelKey));
+  if (dup) return { added: false, row: dup, tokens };
+
+  // Pernah dilepas user → pakai ulang barisnya (kunci unik user+channel)
+  const released = await findReleasedEntry(userId, tokens);
+  if (released) {
+    const [row] = await db
+      .update(sourceBlacklist)
+      .set({
+        origin: input.origin,
+        channelName: input.label?.trim() || released.channelName,
+        tokens: JSON.stringify(Array.from(new Set([...parseTokens(released.tokens), ...tokens]))),
+        reason: input.reason?.slice(0, 300) ?? null,
+        claims: input.claims ?? 0,
+        clips: input.clips ?? 0,
+        ratioPercent: input.ratioPercent ?? 0,
+        createdAt: new Date(),
+      })
+      .where(eq(sourceBlacklist.id, released.id))
+      .returning();
+    return { added: !!row, row: row ?? null, tokens };
+  }
+
+  const [row] = await db
+    .insert(sourceBlacklist)
+    .values({
+      telegramUserId: userId,
+      channelKey: tokens[0],
+      channelName: input.label?.trim() || null,
+      tokens: JSON.stringify(tokens),
+      origin: input.origin,
+      reason: input.reason?.slice(0, 300) ?? null,
+      claims: input.claims ?? 0,
+      clips: input.clips ?? 0,
+      ratioPercent: input.ratioPercent ?? 0,
+    })
+    .onConflictDoNothing()
+    .returning();
+  return { added: !!row, row: row ?? null, tokens };
+}
+
+/** Hapus dari blacklist user — target = nomor urut (dari /blacklist) atau channel (id/nama/handle/URL). */
+export async function removeBlacklistEntry(userId: string, target: string): Promise<SourceBlacklistRow | null> {
+  const rows = await listBlacklist(userId);
+  const trimmed = target.trim();
+  let hit: SourceBlacklistRow | undefined;
+  if (/^\d+$/.test(trimmed)) {
+    hit = rows[parseInt(trimmed, 10) - 1];
+  } else {
+    const token = normalizeChannelToken(trimmed);
+    hit = rows.find((r) => r.channelKey === token || parseTokens(r.tokens).includes(token));
+  }
+  if (!hit) return null;
+  await releaseOrDelete(hit);
+  return hit;
+}
+
+/** Entri auto → ditandai "released" (agar tidak langsung di-blacklist ulang); entri manual → dihapus. */
+async function releaseOrDelete(row: SourceBlacklistRow): Promise<void> {
+  if (row.origin === "auto") {
+    await db.update(sourceBlacklist).set({ origin: "released" }).where(eq(sourceBlacklist.id, row.id));
+  } else {
+    await db.delete(sourceBlacklist).where(eq(sourceBlacklist.id, row.id));
+  }
+}
+
+export async function removeBlacklistById(userId: string, id: number): Promise<SourceBlacklistRow | null> {
+  const row = await getBlacklistEntry(userId, id);
+  if (!row || row.origin === "released") return null;
+  await releaseOrDelete(row);
+  return row;
+}
+
+// ─── PENCOCOKAN ──────────────────────────────────────────────────────────
+
+export interface BlacklistMatch {
+  scope: "env" | "user";
+  label: string;
+  origin?: string;
+  claims?: number;
+  clips?: number;
+  ratioPercent?: number;
+}
+
+/** Cocokkan token channel dengan blacklist (env global + milik user). null = tidak di-blacklist. */
+export async function findBlacklistMatch(userId: string, tokens: string[]): Promise<BlacklistMatch | null> {
+  const wanted = new Set(tokens.filter(Boolean));
+  if (!wanted.size) return null;
+
+  for (const raw of getEnvBlacklist()) {
+    const t = normalizeChannelToken(raw);
+    if (t && wanted.has(t)) return { scope: "env", label: raw };
+  }
+
+  const rows = await listBlacklist(userId);
+  for (const r of rows) {
+    const own = new Set([r.channelKey, ...parseTokens(r.tokens)]);
+    if (Array.from(own).some((t) => wanted.has(t))) {
+      return {
+        scope: "user",
+        label: r.channelName || r.channelKey,
+        origin: r.origin,
+        claims: r.claims,
+        clips: r.clips,
+        ratioPercent: r.ratioPercent,
+      };
+    }
+  }
+  return null;
+}
