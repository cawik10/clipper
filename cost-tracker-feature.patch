+        `   <b>${escapeHtml(formatMoney(u.cost))}</b> · ${u.jobs} job · ${u.calls} panggilan` +
+        (u.jobs > 0 ? ` · ${formatUsd(u.cost / u.jobs)}/job` : "")
+    );
