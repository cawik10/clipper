+            🏷️ Harga model bawaan ({Object.keys(FEATURE_LABELS).length} fitur dilacak) ada di{" "}
+            <code className="text-slate-300">src/lib/cost-config.ts</code> (MODEL_PRICES) — edit satu baris atau pakai COST_PRICE_OVERRIDES.
+          </div>
+        </div>
+      </div>
+    </section>
+  );
+}
